using System;
class Program
{
    static void Main()
    {
        int num = 2345;

        int lastDigit = num % 10;

        int firstDigit = num;
        while (firstDigit >= 10)
        {
            firstDigit /= 10;
        }

        Console.WriteLine($"First = {firstDigit}, Last = {lastDigit}");
    }
}
