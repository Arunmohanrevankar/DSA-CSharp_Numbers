Reverse a Number
using System;
public class Program
{
    public static void Main(string[] args)
    {
        int Data = 1234;
        int Sum = 0;
        while(Data > 0)
        {
            int Test = Data % 10 ; 
            Sum = Test + (Sum*10);
            Data = Data/10;
        }
        Console.WriteLine("revers :"+ Sum);

    }
}













